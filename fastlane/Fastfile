# # fastlane/Fastfile
# #
# # This file defines the automation "lanes" that Fastlane runs.
# #
# # LANES:
# #   - beta    → Builds the app and uploads to TestFlight (triggered by dev-main branch)
# #   - release → Builds the app and uploads to App Store (triggered by main branch)
# #
# # HOW TO RUN LOCALLY (for testing):
# #   bundle exec fastlane beta      ← test the TestFlight lane
# #   bundle exec fastlane release   ← test the App Store lane
# #
# # ─────────────────────────────────────────────────────────────────────────────
# # ⚠️  IMPORTANT: After running `expo prebuild` locally, check the exact name of
# # the generated .xcworkspace and .xcodeproj files inside the ios/ folder.
# # Update the `WORKSPACE_NAME` and `SCHEME_NAME` constants below if needed.
# # Run: ls ios/*.xcworkspace    to see the exact filename.
# # ─────────────────────────────────────────────────────────────────────────────

# # ── Constants ──────────────────────────────────────────────────────────────
# # Verify these by running: npx expo prebuild --platform ios && ls ios/*.xcworkspace
# WORKSPACE_NAME = "GoViTransport"      # ← Update if different (the part before .xcworkspace)
# APP_IDENTIFIER = "com.polygonagro.Transporter"
