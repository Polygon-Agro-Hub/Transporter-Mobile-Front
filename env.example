# .env.example
#
# Template for environment variables needed by this project.
#
# HOW TO USE:
# 1. Copy this file to fastlane/.env (NOT .env — put it INSIDE the fastlane/ folder)
#    Command: cp .env.example fastlane/.env
#
# 2. Fill in your real values in fastlane/.env
#
# 3. NEVER commit fastlane/.env to Git — it contains secrets!
#    It is already listed in .gitignore.
#
# 4. Add all these values to GitHub Secrets for CI/CD automation.
#    (See SETUP_GUIDE.md — PHASE 6)
#
# ─────────────────────────────────────────────────────────────────────────────

# ── App Store Connect API Key ─────────────────────────────────────────────
# Found at: appstoreconnect.apple.com → Integrations → API Keys
# See SETUP_GUIDE.md STEP 2.5 for how to create this.

# The short Key ID (10 characters, e.g., "ABC1234567")
ASC_KEY_ID=

# The Issuer ID (UUID format, e.g., "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx")
ASC_ISSUER_ID=

# The CONTENT of your .p8 file, base64-encoded (single line, no newlines).
# How to generate: base64 -i ~/Desktop/AuthKey_YOURKEY.p8 | tr -d '\n'
ASC_KEY_CONTENT=

# ── Match Certificate Repo ────────────────────────────────────────────────
# Private GitHub repo where your signing certs are stored encrypted.
# See SETUP_GUIDE.md PHASE 3 for how to create this.

# HTTPS URL of the private certs repo
# Example: https://github.com/your-org/transporter-ios-certs.git
MATCH_GIT_URL=

# Base64 encoded "github_username:github_personal_access_token"
# How to generate: echo -n "username:ghp_yourtoken" | base64
MATCH_GIT_BASIC_AUTHORIZATION=

# Password used to encrypt/decrypt certificates stored in the certs repo.
# Choose a strong password and STORE IT SAFELY — if you lose this, you
# cannot decrypt your certs and must regenerate everything.
MATCH_PASSWORD=

# ── API URLs ─────────────────────────────────────────────────────────────
# These replace the environment/environment.ts content at build time.
# DEV_API_URL is injected when building from dev-main branch.
# PROD_API_URL is injected when building from main branch.

# Development/staging API (used in TestFlight builds)
DEV_API_URL=https://transporter-mobile-api.vercel.app/transporter/

# Production API (used in App Store builds)
PROD_API_URL=https://transporter-mobile-api-prod.vercel.app/transporter/

# ── Local Testing Only ────────────────────────────────────────────────────
# Used when running Fastlane locally (not in CI).
# GitHub Actions uses the actual github.run_number instead.
GITHUB_RUN_NUMBER=1
