{
  "expo": {
    "name": "GoVi-Transport",
    "slug": "GoVi-Transport",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./src/assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.polygonagro.Transporter",
      "versionCode": 24,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CALL_PHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE"
      ]
    },
    "ios": {
      "icon": "./src/assets/images/app-icon-ios.png",
      "bundleIdentifier": "com.polygonagro.Transporter",
      "buildNumber": "17",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Camera access is required to scan delivery QR codes, capture proof of delivery photos, and attach images to complaints.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload proof of delivery and complaint images.",
        "NSPhotoLibraryAddUsageDescription": "Photo library access is required to save delivery receipts and complaint images.",
        "NSLocationWhenInUseUsageDescription": "Location access is required to verify delivery location during order completion.",
        "NSFaceIDUsageDescription": "Allow GoVi Transport to use Face ID or Touch ID for fast and secure login."
      }
    },
    "web": {
      "favicon": "./src/assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keep class expo.** { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow GoVi Transport to use Face ID or Touch ID for fast and secure login."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is required to scan delivery QR codes, capture proof of delivery photos, and attach images to complaints.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is required to upload proof of delivery and complaint images.",
          "cameraPermission": "Camera access is required to scan delivery QR codes, capture proof of delivery photos, and attach images to complaints.",
          "microphonePermission": false
        }
      ],
      "expo-location",
      "./plugins/withCustomAndroidPermissions",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7CA21"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
